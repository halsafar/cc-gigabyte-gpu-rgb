# SPDX-License-Identifier: GPL-3.0-or-later
#
# Release build environment: rustup with the toolchain pinned in rust-toolchain.toml
# and the x86_64-unknown-linux-musl target, so `make dist` produces the same static
# binary as CI. Fedora's own Rust packages do not ship the musl target.
FROM registry.fedoraproject.org/fedora:45

RUN dnf -y install --setopt=install_weak_deps=False \
        rustup gcc protobuf-compiler protobuf-devel \
    && dnf clean all

ENV RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo \
    PATH=/opt/cargo/bin:/usr/local/bin:/usr/bin:/bin

COPY rust-toolchain.toml /opt/toolchain/rust-toolchain.toml
RUN rustup-init -y --no-modify-path --profile minimal --default-toolchain none \
    && cd /opt/toolchain && rustup toolchain install \
    && rustc --version && rustup target list --installed

WORKDIR /src
